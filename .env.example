# OrbitGuard Backend – Environment Variables for Render / Railway / VPS
# =====================================================================
# Copy this to .env on the backend host (do NOT commit real values).

# Data mode: "live" (default) serves real precomputed outputs.
# Set to "mock" only for sandbox/demo environments.
DATA_MODE=live

# CORS allowed origins: comma-separated list of frontend URLs allowed to call this API.
# Example: https://your-project.vercel.app,https://www.yourdomain.com
# Set to * only if you do NOT use credentials (cookies/auth headers) in requests.
ALLOWED_ORIGINS=https://your-project.vercel.app

# Uvicorn bind settings (optional — defaults shown):
# HOST=0.0.0.0
# PORT=8000
