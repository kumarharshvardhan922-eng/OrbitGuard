# OrbitGuard Frontend – Environment Variables
# ============================================
# Copy this file to .env.local for local development.
# NEVER commit a file containing real values to git.

# Backend API base URL.
# - Local dev:   leave commented out (defaults to http://127.0.0.1:8000)
# - Production:  set to your deployed FastAPI backend URL, e.g.:
#                VITE_API_BASE=https://orbitguard-api.onrender.com
VITE_API_BASE=

# Data mode: set to "mock" to force offline local engine (no backend needed).
# Leave blank or "live" for normal operation.
VITE_DATA_MODE=live
